# Database
DATABASE_URL="postgresql://user:password@host:port/database"

# JWT
JWT_SECRET="your-super-secret-jwt-key-here-make-it-long-and-random"

# Basic Auth (Optional — ikisi birlikte tanımlanır)
BASIC_USER="admin"
BASIC_PASS="your-admin-password"

# CORS
ALLOWED_ORIGIN="https://yourdomain.com"

# Port
PORT=3005

# Node Environment
NODE_ENV=production

# Önündeki proxy sayısı (rate limit gerçek istemci IP'sini görsün). Üretimde varsayılan 1.
# TRUST_PROXY=1

# Halka açık rezervasyon sitesi origin'i (CORS whitelist'e eklenir; virgülle çoklu değer desteklenir)
PUBLIC_SITE_ORIGIN="https://ssfilo-siteniz.com"

# Vehicle image storage
IMAGE_STORAGE_PROVIDER="local" # local | cloudinary | s3
UPLOAD_DIR="./uploads"
PUBLIC_UPLOAD_BASE_URL="http://localhost:3005/uploads"
MAX_VEHICLE_IMAGE_BYTES="8388608"
MAX_VEHICLE_IMAGES="12"

# JSON backup scheduler
BACKUP_DIR="backups"
BACKUP_MAX_COUNT="30"
BACKUP_FREQUENCY="weekly" # daily | weekly | monthly

# Cloudinary (required when IMAGE_STORAGE_PROVIDER=cloudinary)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# S3-compatible storage (required when IMAGE_STORAGE_PROVIDER=s3)
S3_BUCKET=""
S3_REGION=""
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
